#!/usr/bin/env bash
set -euo pipefail

SOLO_CLI="${SOLO_CLI:-solo-cli}"

usage() {
  cat <<'EOF'
Usage: solo [--force] <directory>

Open (or create) the Solo project for a directory.

  <directory>   directory whose Solo project to open
  --force       create even if registered projects exist beneath the directory
  -h, --help    show this help
EOF
}

die() {
  printf 'solo: %s\n\n' "$1" >&2
  usage >&2
  exit 1
}

fail() {
  printf 'solo: %s\n' "$1" >&2
  exit 1
}

target=""
force=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage >&2
      exit 1
      ;;
    --force)
      force=1
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      [[ -n "$target" ]] && die "expected exactly one directory, got extra argument: $1"
      target="$1"
      ;;
  esac
  shift
done

[[ -n "$target" ]] || die "a directory argument is required"
[[ -e "$target" ]] || die "no such directory: $target"
[[ -d "$target" ]] || die "not a directory: $target"

target="$(realpath "$target")"

api_ready() { "$SOLO_CLI" status --json >/dev/null 2>&1; }
app_running() { ps -axo comm= | grep 'Solo\.app/Contents/MacOS/Solo$' >/dev/null; }

if ! api_ready; then
  if app_running; then
    fail "Solo.app is running but its local API is unreachable — local CLI access is probably off.
Enable local CLI access in Solo's settings, then re-run."
  fi
  open -a Solo
  launch_timeout="${SOLO_LAUNCH_TIMEOUT:-15}"
  deadline=$(($(date +%s) + launch_timeout))
  until api_ready; do
    if (($(date +%s) >= deadline)); then
      fail "timed out after ${launch_timeout}s waiting for Solo.app to answer.
If it is running, enable local CLI access in Solo's settings, then re-run."
    fi
    sleep 0.2
  done
fi

projects_json="$("$SOLO_CLI" projects list --limit 500 --json)" || fail "could not list Solo projects"
jq -e '.ok == true' >/dev/null <<<"$projects_json" || fail "solo-cli reported an error listing projects"
jq -e '.data.hasMore | not' >/dev/null <<<"$projects_json" || fail "more than 500 Solo projects; raise the limit in this script"

ancestor_ignore='["'"$HOME"'"]'

match="$(jq -r --arg path "$target" \
  'first(.data.projects[] | select(.path == $path)) | "\(.id)\t\(.name)"' <<<"$projects_json")"

if [[ -z "$match" ]]; then
  match="$(jq -r --arg path "$target" --argjson ignore "$ancestor_ignore" '
    [.data.projects[]
     | select(.path as $p | $ignore | index($p) | not)
     | select(.path as $pp | ($path + "/") | startswith($pp + "/"))]
    | sort_by(.path | length)
    | last // empty
    | "\(.id)\t\(.name)"' <<<"$projects_json")"
fi

if [[ -n "$match" ]]; then
  id="${match%%$'\t'*}"
  name="${match#*$'\t'}"
else
  descendants="$(jq -r --arg path "$target" '
    .data.projects[]
    | select(.path as $pp | ($pp + "/") | startswith($path + "/"))
    | "  \(.name) (id \(.id)) at \(.path)"' <<<"$projects_json")"

  if [[ -n "$descendants" && $force -eq 0 ]]; then
    fail "registered projects exist beneath $target:
$descendants
pass --force to create a project here anyway"
  fi

  create_json="$("$SOLO_CLI" projects create "$(basename "$target")" "$target" --json)" ||
    fail "could not create a Solo project for $target"
  jq -e '.ok == true' >/dev/null <<<"$create_json" || fail "solo-cli reported an error creating the project"

  id="$(jq -r '.data.project.id' <<<"$create_json")"
  name="$(jq -r '.data.project.name' <<<"$create_json")"
  echo "created $name (id $id) at $target"
fi

open "solo://proj/$id"
echo "opened $name (id $id)"
