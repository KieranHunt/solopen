#!/bin/bash
[ -n "${CLI_LOG:-}" ] && printf '%s\n' "$*" >>"$CLI_LOG"
status_down() {
  echo '{"ok":false,"error":{"code":"discovery_unavailable","message":"Solo app is not reachable"},"command":"status"}'
  exit 69
}
case "$*" in
"status --json")
  case "${STATUS_MODE:-ok}" in
  ok) echo '{"ok":true,"command":"status"}' ;;
  down) status_down ;;
  after-launch)
    [ -f "$LAUNCH_MARKER" ] || status_down
    echo '{"ok":true,"command":"status"}'
    ;;
  esac
  ;;
"projects list --limit 500 --json") cat "$PROJECTS_JSON" ;;
"projects create "*)
  printf '{"ok":true,"command":"projects create","data":{"project":{"id":13,"name":"%s","displayName":null,"path":"%s"},"alreadyExists":false}}\n' "$3" "$4"
  ;;
*)
  echo "stub solo-cli: unexpected args: $*" >&2
  exit 64
  ;;
esac
